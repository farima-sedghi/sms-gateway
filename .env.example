# Copy to .env to override defaults: cp .env.example .env
# Every value below is already the default in deployments/docker-compose.yml.

# --- Shared by api, dispatcher, outbox-relay ---
# Postgres DSN. Pool tuning goes here too, e.g. &pool_max_conns=20
DATABASE_URL=postgres://sms:sms@postgres:5432/sms?sslmode=disable
# debug | info | warn | error
LOG_LEVEL=info

# --- api ---
# Price of one SMS in minor units (integer, > 0). Same for normal and express.
SMS_PRICE=100
# Express messages not handed to the operator within this are not sent
# (failed + refunded). Express latency guarantee.
EXPRESS_TTL=2m

# --- outbox-relay ---
# Rows claimed per batch, per lane. A full batch loops again at once.
OUTBOX_BATCH_SIZE=500
# Sleep after a partial/empty batch. Express polls more often (lower latency).
OUTBOX_EXPRESS_IDLE=20ms
OUTBOX_NORMAL_IDLE=100ms
# Published rows are deleted after this long (kept for debugging/replay).
OUTBOX_RETENTION=1h
OUTBOX_CLEANUP_INTERVAL=1m
# How often each lane logs its lag (age of the oldest unpublished row).
OUTBOX_LAG_INTERVAL=10s

# --- Kafka ---
# Containers always use kafka:9092 (set in compose). For tools on your machine, use localhost:29092.
# Fixed KRaft cluster id so the data volume survives restarts. Generate with kafka-storage.sh random-uuid.
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# --- dispatcher ---
# Per-call operator timeout. A timeout after the request was sent = Unknown outcome.
OPERATOR_TIMEOUT=5s
# Total send attempts before a message goes to sms.dlq.
MAX_ATTEMPTS=5
# Retry delay: RETRY_BASE_DELAY * 2^(attempt-1), capped at RETRY_MAX_DELAY.
RETRY_BASE_DELAY=1s
RETRY_MAX_DELAY=30s
# Worker pool (max concurrent sends) and fetch batch per lane. Express has its own.
EXPRESS_WORKERS=32
EXPRESS_BATCH_SIZE=64
NORMAL_WORKERS=64
NORMAL_BATCH_SIZE=256
RETRY_WORKERS=16
RETRY_BATCH_SIZE=64

# --- operator-mock ---
# Simulated latency of a successful send.
OPERATOR_LATENCY=50ms
# Failure probabilities (0..1, must add up to <= 1; the rest succeeds):
#   temp -> 503, perm -> 400, timeout -> delivered but the answer is delayed
#   by OPERATOR_TIMEOUT_DELAY (the client sees an Unknown outcome).
OPERATOR_TEMP_FAILURE_RATE=0
OPERATOR_PERM_FAILURE_RATE=0
OPERATOR_TIMEOUT_RATE=0
OPERATOR_TIMEOUT_DELAY=30s

# --- Build ---
# Go module proxy used inside the Docker build (use a mirror if proxy.golang.org is blocked).
GOPROXY=https://proxy.golang.org,direct

# --- Host ports ---
API_PORT=8081
OPERATOR_PORT=8090
KAFKA_UI_PORT=8080
KAFKA_HOST_PORT=29092
POSTGRES_PORT=5432
